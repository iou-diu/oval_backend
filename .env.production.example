# Production configuration for deploy.sh / update.sh.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#
# .env.production is git-ignored. Format: one KEY=value per line, # starts a
# comment line. The file is read line by line (never sourced), so values may
# contain any character ($, #, quotes, spaces...). Surrounding quotes are
# stripped: KEY="value" and KEY=value are the same.
#
# Lowercase keys configure the deployment. Every other key is copied unchanged
# into the app's .env, which deploy.sh generates (do not edit that one).

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# Short unique name: supervisor program, nginx site file, cache key prefix.
project_name=oval_backend
# Where the code lives (absolute path). Static files, media, cache, the
# gunicorn socket and the venv are all created inside it.
project_folder=/home/oval/oval_backend
# Log folder for gunicorn (default: <project_folder>/logs). nginx logs go to
# /var/log/nginx/<project_name>.access.log / .error.log.
logs=
# Non-root user the app runs as. Create it first:
#   adduser --disabled-password --gecos "" oval
run_user=oval

# Optional: clone/pull from git when deploy.sh is NOT inside project_folder.
# Leave empty when you clone the repo yourself and run deploy.sh from it.
# Root runs the clone, so an SSH URL needs root's SSH key to have access.
git_repo=
git_branch=main

# Comma separated host names served by nginx and accepted by Django, e.g.
# api.example.com,www.api.example.com. A public IP works too. Leave empty only
# together with a free nginx_port other than 80.
domain=api.example.com
# Port nginx listens on for HTTP (default 80). HTTPS always uses 443.
nginx_port=80
# Comma separated frontend origins allowed for CORS and CSRF
# (scheme + host [+ port], no path), e.g. https://shop.example.com
frontend_urls=https://shop.example.com
# gunicorn worker processes (default 3). Each worker loads the whole app
# (pandas, prophet...), so budget roughly 300 MB of RAM per worker.
gunicorn_workers=3
# Largest request body nginx accepts (uploads), e.g. 20M (default 20M).
max_upload_size=20M

# PostgreSQL. On a local PostgreSQL, deploy.sh creates the role and database
# if they are missing; it never drops anything and never changes the password
# of an existing role. For a remote server, create them there yourself.
database_name=oval_backend
database_user=oval_backend
database_password=change-me
database_host=localhost
database_port=5432

# Optional superuser, created once if no user has this email (an existing
# user's password is never changed). Leave both empty to skip.
admin_email=
admin_password=

# Optional Redis cache. If set, Redis must already be running and reachable or
# the deploy stops. Empty = file cache in <project_folder>/cache (shared by all
# gunicorn workers). Keys are prefixed with project_name.
redis_host=
redis_port=6379

# ---------------------------------------------------------------------------
# App settings (copied unchanged into the app .env)
# ---------------------------------------------------------------------------
# deploy.sh generates these itself, so do not set them here unless you mean
# to replace the generated value: DEBUG (False), ALLOWED_HOSTS,
# CSRF_TRUSTED_ORIGINS, CORS_ALLOWED_ORIGINS, DATABASE_URL, REDIS_HOST,
# REDIS_PORT, CACHE_DIR, CACHE_KEY_PREFIX, STATIC_ROOT, MEDIA_ROOT,
# BEHIND_PROXY, SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE.
#
# SECRET_KEY: leave unset and deploy.sh generates one on the first deploy and
# keeps it afterwards. Set it only to move an existing key to this server.
# SECRET_KEY=

# Email (SMTP, e.g. SendGrid)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# MailerSend API key. Required: read when the app starts.
MAILERSEND_API_KEY=

# OpenAI API key. Required: read when the app starts (product meta generator).
OPENAI_API_KEY=

# Typesense product search. All three are required: read when the app starts.
TYPESENSE_IP=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_KEY=

# SSLCommerz payment gateway. These keys are lowercase in the app code, which
# is fine: only the deploy keys above are treated specially.
store_id=
store_passwd=
success_url=https://shop.example.com/payment/success
SSL_VALIDATE_URL=https://securepay.sslcommerz.com/validator/api/validationserverAPI.php
IS_SSL_SANDBOX=False

# Django log level for the gunicorn log (default WARNING).
# DJANGO_LOG_LEVEL=WARNING
